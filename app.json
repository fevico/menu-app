{
  "expo": {
    "name": "Fevico Menu",
    "slug": "fevico-menu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fevicomenu",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": { 
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/menu-icon.png",
        "monochromeImage": "./assets/images/menu-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fevico.fevicomenu"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7b8ffb4-568a-44b9-b03a-c9c6d4f2f66a"
      }
    }
  }
}
